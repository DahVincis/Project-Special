# The Google reviews key is not a React variable. CRA would bake a
# REACT_APP_GOOGLE_MAPS_KEY into the public bundle. Local wrangler reads
# GOOGLE_MAPS_KEY from client/.dev.vars; production reads the Worker secret.
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_BUCKET=your-public-bucket-name
REACT_APP_SUPABASE_ANON_KEY=your-anon-public-key
