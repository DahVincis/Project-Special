{
  // Static site plus GET /api/reviews. The Google key is the Worker secret
  // GOOGLE_MAPS_KEY — not a build variable, and not in the client bundle.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "special-finishes-hi",
  "main": "./worker/index.mjs",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "./build",
    // /api/reviews is not a file in ./build. Run the Worker for that path
    // before asset matching so a future file cannot shadow it.
    "binding": "ASSETS",
    "run_worker_first": ["/api/reviews"]
  },
  // Workers Caching stores the reviews response from its Cache-Control header
  // and serves later requests without running the Worker. See worker/index.mjs.
  "cache": {
    "enabled": true
  },
  // GA4_SA_KEY and RESEND_API_KEY are read by the Monday report and are
  // intentionally omitted from secrets.required. A required secret that is
  // still unset makes wrangler deploy refuse to publish. Until they are set,
  // the cron logs and returns; /api/reviews is unaffected. See client/README.md.
  "secrets": {
    "required": ["GOOGLE_MAPS_KEY"]
  },
  "vars": {
    "REPORT_TO": "specialfinisheshi@gmail.com,ruiterfernandes77@gmail.com"
  },
  // Monday 8:00 AM America/New_York. Cron triggers are UTC. Eastern is UTC-5
  // in winter (EST) and UTC-4 in summer (EDT), so both hours are registered.
  // scheduled() sends only when the America/New_York hour is 8.
  "triggers": {
    "crons": ["0 12 * * 1", "0 13 * * 1"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
